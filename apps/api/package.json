{
  "name": "@magaram/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "default": "./dist/maintenance.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src tests prisma --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.tests.json",
    "db:generate": "prisma generate",
    "db:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=../../.env --import tsx prisma/seed.ts",
    "db:seed-super-admin": "node --env-file=../../.env --import tsx prisma/seed-super-admin.ts",
    "db:validate": "node --env-file=../../.env node_modules/prisma/build/index.js validate"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
    "@aws-sdk/client-sesv2": "^3.1134.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
