generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum AppRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  REPORTER
  FACT_CHECKER
  SOCIAL_MANAGER
  SALES_MANAGER
  ADVERTISER
  BUSINESS_OWNER
  RECRUITER
  FINANCE
  ANALYST
  CONTRIBUTOR
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique @db.VarChar(320)
  displayName     String      @db.VarChar(160)
  passwordHash    String      @db.VarChar(255)
  status          UserStatus  @default(ACTIVE)
  failedLoginAttempts Int     @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  roles           UserRole[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  auditEvents     AuditLog[]  @relation("AuditActor")
  articles        Article[]
  aiRuns          AiRun[]

  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  code        AppRole          @unique
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(191)
  requestId  String?  @db.VarChar(100)
  ipHash     String?  @db.Char(64)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(160)
  value       Json
  description String?  @db.VarChar(500)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EditorialStatus {
  DRAFT
  AI_DRAFT
  EDITOR_REVIEW
  FACT_CHECK
  APPROVED
  SCHEDULED
  PUBLISHED
  UPDATED
  ARCHIVED
}

model Article {
  id String @id @default(cuid())
  slug String @unique @db.VarChar(191)
  title String @db.VarChar(250)
  summary String @db.Text
  body String @db.LongText
  type String @default("NEWS") @db.VarChar(32)
  status EditorialStatus @default(DRAFT)
  sensitive Boolean @default(false)
  sponsored Boolean @default(false)
  isDemo Boolean @default(false)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  category String @db.VarChar(100)
  location String @db.VarChar(100)
  tags Json
  imageId String?
  image MediaAsset? @relation(fields: [imageId], references: [id])
  seoTitle String? @db.VarChar(250)
  seoDescription String? @db.VarChar(320)
  version Int @default(1)
  approvedBy String? @db.VarChar(191)
  approvedAt DateTime?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources ArticleSource[]
  claims ArticleClaim[]
  revisions ArticleRevision[]
  corrections Correction[]
  aiRuns AiRun[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([location, status])
  @@index([authorId])
  @@index([status, scheduledAt])
}

model ArticleSource {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  label String @db.VarChar(250)
  url String @db.VarChar(1000)
  verified Boolean @default(false)
  @@index([articleId])
}

model ArticleClaim {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  text String @db.Text
  status String @default("UNVERIFIED") @db.VarChar(32)
  evidence String @db.Text
  checkedBy String? @db.VarChar(191)
  @@index([articleId])
}

model ArticleRevision {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actorId String @db.VarChar(191)
  version Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([articleId, version])
}

model Correction {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actorId String @db.VarChar(191)
  reason String @db.Text
  createdAt DateTime @default(now())
  @@index([articleId, createdAt])
}

model Taxonomy {
  id String @id @default(cuid())
  kind String @db.VarChar(30)
  slug String @db.VarChar(100)
  name String @db.VarChar(160)
  createdAt DateTime @default(now())
  @@unique([kind, slug])
}

model MediaAsset {
  id String @id @default(cuid())
  filename String @db.VarChar(191)
  mime String @db.VarChar(100)
  size Int
  width Int?
  height Int?
  sha256 String? @db.Char(64)
  alt String @db.VarChar(300)
  credit String @db.VarChar(300)
  ownerId String @db.VarChar(191)
  rightsStatus MediaRightsStatus @default(PENDING)
  rightsSource String? @db.VarChar(1000)
  rightsReviewedBy String? @db.VarChar(191)
  rightsReviewedAt DateTime?
  createdAt DateTime @default(now())
  articles Article[]

  @@index([rightsStatus, createdAt])
}

enum MediaRightsStatus {
  PENDING
  CLEARED
  REJECTED
}

enum SocialConsentChannel {
  FACEBOOK
  INSTAGRAM
  X
  WHATSAPP
  TELEGRAM
  YOUTUBE
}

model SocialConsent {
  id         String              @id @default(cuid())
  subjectHash String              @db.Char(64)
  channel    SocialConsentChannel
  purpose    String              @db.VarChar(120)
  source     String              @db.VarChar(500)
  grantedAt  DateTime            @default(now())
  revokedAt  DateTime?
  createdAt  DateTime            @default(now())

  @@index([subjectHash, channel, purpose])
  @@index([revokedAt, channel])
}

enum BusinessStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

model LocalBusiness {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(180)
  slug        String         @unique @db.VarChar(191)
  description String         @db.Text
  category    String         @db.VarChar(100)
  location    String         @db.VarChar(100)
  phone       String?        @db.VarChar(40)
  website     String?        @db.VarChar(500)
  ownerId     String?
  status      BusinessStatus @default(PENDING)
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  offers      LocalOffer[]
  leads       LocalLead[]

  @@index([status, location])
  @@index([ownerId])
}

model LocalOffer {
  id          String      @id @default(cuid())
  businessId  String
  title       String      @db.VarChar(180)
  description String      @db.Text
  terms       String?     @db.Text
  startsAt    DateTime
  endsAt      DateTime
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    LocalBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads       LocalLead[]

  @@index([businessId, status, endsAt])
}

model LocalLead {
  id         String     @id @default(cuid())
  businessId String
  offerId    String?
  name       String     @db.VarChar(160)
  email      String     @db.VarChar(320)
  phone      String?    @db.VarChar(40)
  message    String     @db.Text
  consentAt  DateTime
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   LocalBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offer      LocalOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
}

enum AiRunStatus {
  RUNNING
  READY
  FAILED
  ACCEPTED
  REJECTED
}

model AiRun {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  articleId String
  article Article @relation(fields: [articleId], references: [id])
  articleVersion Int
  requestKey String @db.VarChar(64)
  task String @db.VarChar(40)
  status AiRunStatus @default(RUNNING)
  promptVersion String @db.VarChar(80)
  inputHash String @db.Char(64)
  inputSnapshot Json
  sourceIds Json
  provider String @db.VarChar(100)
  model String @db.VarChar(200)
  output Json?
  inputTokens Int?
  outputTokens Int?
  failureCode String? @db.VarChar(60)
  reviewNote String? @db.Text
  reviewedBy String? @db.VarChar(191)
  reviewedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([actorId, requestKey])
  @@index([articleId, createdAt])
  @@index([status, expiresAt])
}

model AiDailyUsage {
  scope String @db.VarChar(191)
  day String @db.Char(10)
  requests Int @default(0)
  @@id([scope, day])
}

enum AdCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AdInvoiceStatus {
  UNPAID
  VOID
}

enum MarketplaceCategory {
  JOB
  CLASSIFIED
  PROPERTY
  EDUCATION
  DEAL
}

enum MarketplaceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model Advertiser {
  id String @id @default(cuid())
  ownerId String @unique @db.VarChar(191)
  name String @db.VarChar(180)
  contactEmail String @db.VarChar(320)
  billingAddress String @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns AdCampaign[]
}

model AdPlacement {
  id String @id @default(cuid())
  key String @unique @db.VarChar(80)
  name String @db.VarChar(180)
  enabled Boolean @default(false)
  dailyRatePaise Int?
  version Int @default(1)
  updatedAt DateTime @updatedAt
  campaigns AdCampaign[]
}

model AdCampaign {
  id String @id @default(cuid())
  advertiserId String
  advertiser Advertiser @relation(fields: [advertiserId], references: [id])
  placementId String
  placement AdPlacement @relation(fields: [placementId], references: [id])
  headline String @db.VarChar(180)
  body String @db.Text
  destinationUrl String @db.VarChar(1000)
  rightsEvidence String @db.VarChar(2000)
  disclosure String @default("விளம்பரம்") @db.VarChar(100)
  startsAt DateTime
  endsAt DateTime
  status AdCampaignStatus @default(DRAFT)
  version Int @default(1)
  submittedBy String? @db.VarChar(191)
  lastEditedBy String @db.VarChar(191)
  reviewedBy String? @db.VarChar(191)
  reviewedAt DateTime?
  reviewNote String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice AdInvoice?
  @@index([advertiserId, createdAt])
  @@index([placementId, status, startsAt, endsAt])
}

model AdInvoice {
  id String @id @default(cuid())
  campaignId String @unique
  campaign AdCampaign @relation(fields: [campaignId], references: [id])
  currency String @default("INR") @db.Char(3)
  amountPaise Int
  dailyRatePaise Int
  days Int
  billingSnapshot Json
  status AdInvoiceStatus @default(UNPAID)
  createdAt DateTime @default(now())
  voidedAt DateTime?
  attempts AdPaymentAttempt[]
}

model AdPaymentAttempt {
  id String @id @default(cuid())
  invoiceId String
  invoice AdInvoice @relation(fields: [invoiceId], references: [id])
  requestKey String @db.VarChar(100)
  status String @default("UNAVAILABLE") @db.VarChar(30)
  createdAt DateTime @default(now())
  @@unique([invoiceId, requestKey])
}

model MarketplaceListing {
  id              String              @id @default(cuid())
  ownerId         String
  category        MarketplaceCategory
  title           String              @db.VarChar(180)
  description     String              @db.Text
  location        String              @db.VarChar(120)
  priceOrSalary   String?             @db.VarChar(120)
  contactEmail    String              @db.VarChar(320)
  contactPhone    String?             @db.VarChar(40)
  rightsEvidence  String              @db.VarChar(2000)
  expiresAt       DateTime
  status          MarketplaceStatus   @default(DRAFT)
  version         Int                 @default(1)
  submittedBy     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?             @db.VarChar(2000)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reports         MarketplaceReport[]

  @@index([status, category, expiresAt])
  @@index([ownerId, createdAt])
}

model MarketplaceReport {
  id         String             @id @default(cuid())
  listingId  String
  reporterId String?
  reason     String             @db.VarChar(1000)
  createdAt  DateTime           @default(now())
  listing    MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}
