# Application
NODE_ENV=development
APP_VERSION=0.1.0
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
TRUST_PROXY=false

# Infrastructure — use local non-production values only. Do not commit real credentials.
DATABASE_URL=mysql://magaram:change-me@localhost:3306/magaram_media
REDIS_URL=redis://localhost:6379

# Generate a unique value of at least 32 characters for each environment.
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret

# Provider integrations stay inactive until the real provider is configured and delivery is tested.
AWS_REGION=ap-south-1
AI_PROVIDER=inactive
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
AI_DAILY_PER_USER=10
AI_DAILY_GLOBAL=50
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000
EMAIL_PROVIDER=inactive
# SES_FROM_EMAIL=magaram.in@gmail.com
# Workspace SMTP relay: prefer IP-restricted smtp-relay.gmail.com with no mailbox password.
# WORKSPACE_SMTP_HOST=smtp-relay.gmail.com
# WORKSPACE_SMTP_PORT=587
# WORKSPACE_SMTP_FROM_EMAIL=admin@magarammedia.in
# WORKSPACE_SMTP_USERNAME=
# WORKSPACE_SMTP_PASSWORD=
# PASSWORD_RESET_BASE_URL=https://your-domain.example
